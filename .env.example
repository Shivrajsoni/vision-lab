# Copy to apps/web/.env.local for local development. Never commit real values.
# All variables are optional: with none set, every in-browser model still works.
# None of these may be prefixed with NEXT_PUBLIC_ — they must stay on the server.

# Shared-GPU tier (phase 4): base URL of the Hugging Face ZeroGPU Space.
SPACE_URL=

# Hosted-model tier (phase 4): Cloudflare Workers AI, free allowance of 10,000 neurons/day.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
